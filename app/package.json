{
  "name": "adaptive-skills-desktop",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:sidecar": "node scripts/python-runner.mjs ../scripts/build_desktop_sidecar.py",
    "build:bundle": "npm run build:sidecar && npm run build",
    "build:macos": "tauri build --ci --bundles app,dmg",
    "build:windows": "tauri build --ci --bundles nsis",
    "build:linux": "tauri build --ci --bundles appimage,deb",
    "verify:bundle": "node scripts/python-runner.mjs ../scripts/verify_desktop_bundle.py",
    "test": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
